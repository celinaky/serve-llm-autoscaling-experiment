+@pytest.mark.asyncio
+async def test_request_audit_separates_original_booking_decay_and_completion(
+    monkeypatch, tmp_path
+):
+    clock = SimpleNamespace(now=1000.0)
+    monkeypatch.setattr(
+        kv_token_tracker,
+        "time",
+        SimpleNamespace(monotonic=lambda: clock.now, time=lambda: 1700000000 + clock.now),
+    )
+    monkeypatch.setenv(kv_token_tracker.ROUTER_REQUEST_TRACE_DIR_ENV, str(tmp_path))
+    tracker = _LocalTracker(prefill_decay_tokens_per_second=10)
+    tracker._register_block_size(16, "test-worker")
+    tracker._replica_id_by_worker[1] = "test-worker"
+    tracker._svc.select_and_reserve = AsyncMock(
+        return_value={
+            "worker_id": 1, "dp_rank": 0,
+            "overlap": {"longest_matched": 16, "gpu": 16, "cpu": 16},
+            "effective_prefill_tokens": 48,
+        }
+    )
+    tracker.set_autoscaling_metrics_sink(lambda snapshot: None)
+    try:
+        await tracker.select_worker("client-request", list(range(64)), [1])
+        clock.now += 2
+        tracker._publish_autoscaling_snapshot()
+        await tracker.on_prefill_complete("client-request")
+    finally:
+        if tracker._prefill_decay_timer is not None:
+            tracker._prefill_decay_timer.cancel()
+        tracker._request_trace_writer.close()
+    rows = [json.loads(line) for path in tmp_path.glob("*.jsonl")
+            for line in path.read_text().splitlines()]
+    selection = next(r for r in rows if r["event"] == "router_selection")
+    assert selection["request_id"] == "client-request"
+    assert selection["prompt_tokens"] == 64
+    assert selection["overlap"]["gpu"] == 16
+    assert selection["effective_prefill_tokens"] == 48
+    assert "token_ids" not in selection
+    snapshots = [r for r in rows if r["event"] == "router_autoscaling_snapshot"]
+    assert [r[PREFILL] for r in snapshots] == [0, 48, 28, 0]
+    assert snapshots[-2]["requests"][0]["remaining_estimate_tokens"] == 28
+    assert snapshots[-2]["requests"][0]["initial_effective_prefill_tokens"] == 48
+    assert snapshots[-1]["requests"] == []
+    assert any(r["event"] == "router_prefill_complete" for r in rows)

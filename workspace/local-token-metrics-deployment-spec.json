{
  "model_loading_config": {
    "model_id": "Qwen/Qwen3.6-27B-FP8",
    "model_source": "Qwen/Qwen3.6-27B-FP8"
  },
  "engine_kwargs": {
    "tensor_parallel_size": 1,
    "max_model_len": 262144,
    "gpu_memory_utilization": 0.92,
    "max_num_seqs": 512,
    "max_num_batched_tokens": 16384,
    "enable_prefix_caching": true,
    "kv_offloading_size": 64.0,
    "kv_offloading_backend": "native",
    "enable_prompt_tokens_details": true,
    "kv_cache_dtype": "fp8",
    "language_model_only": true,
    "scheduler_cls": "serve_profiler.scheduler.AutoTracingScheduler"
  },
  "deployment_config": {
    "autoscaling_config": {
      "min_replicas": 1,
      "initial_replicas": 1,
      "max_replicas": 8,
      "target_ongoing_requests": 8.0,
      "upscale_delay_s": 40.0,
      "downscale_delay_s": 1800.0,
      "metrics_interval_s": 2,
      "look_back_period_s": 60,
      "policy": {
        "policy_function": "ray.serve.experimental.llm_token_autoscaling_policy:LLMTokenAutoscalingPolicy",
        "policy_kwargs": {
          "target_prefill_tokens_per_replica": 20000
        }
      }
    },
    "request_router_config": {
      "request_router_class": "ray.serve.llm.request_router.KVAwareRouter",
      "request_router_kwargs": {}
    }
  },
  "accelerator_type": "H100",
  "runtime_env": {
    "py_modules": [
      "/home/ray/default/serve-llm-profiler/serve_profiler"
    ],
    "worker_process_setup_hook": "serve_profiler.compat.setup",
    "env_vars": {
      "SERVE_PROFILER_TRACE_DIR": "/mnt/cluster_storage/serve-llm-autoscaling-experiment/paired-scheduler-traces/token-metrics-local",
      "RAY_SERVE_VLLM_SCHEDULER_TRACE_DIR": "",
      "PYTHONPATH": "/home/ray/default/serve-llm-profiler:src"
    }
  }
}
